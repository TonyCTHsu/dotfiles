# Machine-local overrides come first so first-value-wins applies to them
Include ~/.ssh/config.local

Include ~/.colima/ssh_config

Host github.com
  HostName github.com
  User git

Host thinkcentre
  # Tailscale MagicDNS name; set to the box's name after `sudo tailscale up`.
  # Adjust User if the Omarchy username differs.
  HostName thinkcentre
  User tony
