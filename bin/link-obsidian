#!/bin/sh

# Symlink Obsidian appearance config (in dotfiles/obsidian) into the vault's
# .obsidian directory, so it stays in sync across machines.
#
# Only the appearance-related subset is linked: appearance.json,
# core-plugins.json, community-plugins.json, snippets/, themes/.
# Everything else in .obsidian/ (workspace.json, graph.json, app.json,
# plugins/, .DS_Store) is left untouched - it's machine/session-specific
# or out of scope.
#
# Usage: bin/link-obsidian [vault_path]
#   Defaults to $HOME/obsidian

set -e

DOTFILES_OBSIDIAN="$HOME/dotfiles/obsidian"
VAULT_PATH="${1:-$HOME/obsidian}"
OBSIDIAN_DIR="$VAULT_PATH/.obsidian"

if [ ! -d "$OBSIDIAN_DIR" ]; then
  echo >&2 "No .obsidian directory found at $OBSIDIAN_DIR"
  exit 1
fi

link_item() {
  name="$1"
  src="$DOTFILES_OBSIDIAN/$name"
  dest="$OBSIDIAN_DIR/$name"

  if [ -L "$dest" ]; then
    current_target="$(readlink "$dest")"
    if [ "$current_target" = "$src" ]; then
      echo "already linked: $name"
      return
    else
      echo >&2 "skipping $name: already a symlink to $current_target"
      return
    fi
  fi

  if [ -e "$dest" ]; then
    if diff -rq "$dest" "$src" >/dev/null 2>&1; then
      rm -rf "$dest"
    else
      echo >&2 "skipping $name: $dest exists and differs from $src (resolve manually)"
      return
    fi
  fi

  ln -s "$src" "$dest"
  echo "linked: $name"
}

for name in appearance.json core-plugins.json community-plugins.json snippets themes; do
  link_item "$name"
done
