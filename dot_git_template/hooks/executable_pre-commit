#!/bin/bash

# Pre-commit hook to check and fix trailing whitespace
# This hook will:
# 1. Check for trailing whitespace in staged files
# 2. Automatically fix it if found
# 3. Re-stage the cleaned files
# 4. Continue with the commit

set -e

# Get list of staged files (only text files we care about)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(rb|go|sh|md|txt|yml|yaml|json|js|ts|css|html)$' || true)

if [ -n "$STAGED_FILES" ]; then
    # Check for trailing whitespace
    WHITESPACE_FILES=()
    for file in $STAGED_FILES; do
        if [ -f "$file" ] && grep -qE '[[:space:]]+$' "$file"; then
            WHITESPACE_FILES+=("$file")
        fi
    done

    if [ ${#WHITESPACE_FILES[@]} -gt 0 ]; then
        echo "Fixing trailing whitespace in ${#WHITESPACE_FILES[@]} file(s):"
        for file in "${WHITESPACE_FILES[@]}"; do
            echo "   - $file"
        done

        for file in "${WHITESPACE_FILES[@]}"; do
            # Remove trailing whitespace
            sed -i '' 's/[[:space:]]*$//' "$file"

            # Ensure file ends with newline
            if [ -s "$file" ] && [ "$(tail -c1 "$file")" != "" ]; then
                echo "" >> "$file"
            fi
            # Re-stage the fixed file
            git add "$file"
        done
    fi
fi

# Run StandardRB on Ruby files
# When the repo has its own standard config, run `standardrb --fix` WITHOUT file
# arguments: passing explicit paths bypasses the repo's ignore list
# (.standard_todo.yml), which reformats files the project deliberately keeps
# out of standard. When there is no config, fall back to staged files only.
RUBY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rb$' || true)

if [ -n "$RUBY_FILES" ]; then
    if ! command -v standardrb >/dev/null 2>&1; then
        echo "standardrb not installed; skipping style fix"
    elif [ -f .standard.yml ] || [ -f .standard_todo.yml ]; then
        if standardrb --fix; then
            # Re-stage the fixed files
            git add $RUBY_FILES
        else
            echo "StandardRB found issues that couldn't be auto-fixed"
            exit 1
        fi
    else
        if standardrb --fix $RUBY_FILES; then
            git add $RUBY_FILES
        else
            echo "StandardRB found issues that couldn't be auto-fixed"
            exit 1
        fi
    fi
fi

# Run Vale on Markdown files
# echo "🔍 Running Vale linter..."
# MARKDOWN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)
#
# if [ -n "$MARKDOWN_FILES" ]; then
#     if command -v vale >/dev/null 2>&1; then
#         echo "📝 Checking Markdown files with Vale..."
#         if vale "$MARKDOWN_FILES"; then
#             echo "✅ Vale checks passed"
#         else
#             echo "⚠️  Vale found style issues in Markdown files (not blocking commit)"
#             echo "💡 You can run 'vale <filename>' to check specific files"
#         fi
#     else
#         echo "⚠️  Vale not found - skipping Markdown checks"
#         echo "💡 Install with: brew install vale"
#     fi
# else
#     echo "✅ No Markdown files to check"
# fi

local_hook="$HOME"/.git_template.local/hooks/pre-commit

if [ -f "$local_hook" ]; then
  . "$local_hook"
fi
